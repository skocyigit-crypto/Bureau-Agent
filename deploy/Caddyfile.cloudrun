# Caddyfile.cloudrun — Ajant Bureau (Cloud Run variant)
#
# Cloud Run runs each service in its own isolated network — there is no
# shared Docker Compose network to resolve a bare "api:8080" hostname
# against, so unlike deploy/Caddyfile (docker-compose), this variant
# reverse-proxies to the API's real Cloud Run HTTPS URL, injected at
# container start via the API_UPSTREAM env var.
#
# Cloud Run also terminates TLS itself in front of the container and
# always talks to the container over plain HTTP on $PORT, so this Caddyfile
# never does its own TLS/ACME — it just listens on :{$PORT}.

:{$PORT:8080} {
        encode zstd gzip

        # Applies to every response in this site block (static + proxied /api).
        # The api-server sets its own security headers on its JSON responses
        # already (helmet), but the static SPA served directly by Caddy had
        # none of these.
        header {
                Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
                X-Content-Type-Options "nosniff"
                X-Frame-Options "DENY"
                Referrer-Policy "strict-origin-when-cross-origin"
                # Permissions-Policy: la meme valeur que api-server (app.ts) et
                # deploy/non-docker/nginx.conf. Elle manquait ICI, et c'est ici
                # qu'elle compte: ce bloc sert le DOCUMENT de l'application,
                # celui qui execute le JavaScript. Pose sur les reponses JSON de
                # /api, ce header ne gouverne aucune capacite navigateur de la
                # page.
                #
                # Constate en ligne le 2026-09-03: app.agentdebureau.fr ne
                # renvoyait aucun Permissions-Policy, alors que trois fichiers
                # du depot en definissent un — mais deux d'entre eux
                # (vite.config.ts, non-docker/nginx.conf) ne tournent pas en
                # production, et le troisieme ne couvre que /api.
                Permissions-Policy "accelerometer=(), autoplay=(), camera=(self), cross-origin-isolated=(), display-capture=(self), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), hid=(), identity-credentials-get=(), idle-detection=(), interest-cohort=(), keyboard-map=(), magnetometer=(), microphone=(self), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), sync-xhr=(), usb=(), xr-spatial-tracking=()"
                # Content-Security-Policy — voir deploy/csp.policy.md.
                # Report-Only pour l instant: la mesure a ete faite sur le
                # build reel et ne signale zero violation, mais seul l ecran
                # de connexion a pu etre ouvert (ni base ni API en local).
                # Une CSP fausse sur une page interne ne produirait pas un
                # defaut discret: elle casserait la page d un client qui paie.
                # La valeur doit rester identique a deploy/csp.policy
                # (verifie par csp-policy.test.ts).
                Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; form-action 'self' https://checkout.stripe.com https://billing.stripe.com https://accounts.google.com; base-uri 'none'; object-src 'none'; upgrade-insecure-requests"
        }

        # `handle` blocks are only mutually exclusive with OTHER `handle`/
        # `handle_path` blocks in the same scope — a bare `file_server` /
        # `try_files` left at the top level still runs for every request
        # regardless of the block above, which silently served index.html
        # for /api/* instead of proxying. Wrapping the static site in its
        # own `handle` makes the two routes properly exclusive.
        handle /api* {
                # Cloud Run's own edge always terminates TLS in front of the api
                # service, so the upstream must be dialed over HTTPS (a bare
                # host:443 defaults to plain HTTP in Caddy, which the target
                # rejects, breaking the connection with EOF).
                reverse_proxy https://{$API_UPSTREAM} {
                        header_up Host {upstream_hostport}
                        # Cloud Run's edge sets X-Forwarded-For correctly on THIS hop
                        # (client -> web service), but the NEXT hop (this reverse_proxy
                        # call -> api service's own Cloud Run edge) collapses it to a
                        # shared internal address (Cloud Run's own link-local proxy IP),
                        # not the real visitor — every web-app user then looks like the
                        # same "client" to the api service, which let one visitor's
                        # traffic burst rate-limit/ban everyone (2026-07-14 incident,
                        # see AI_AUTOMATION_ROADMAP.md). Snapshot the real value into a
                        # dedicated header before that hop; Cloud Run has no special
                        # handling for it, so it survives untouched. Backend prefers
                        # this over X-Forwarded-For (lib/request-ip.ts).
                        header_up X-Real-Client-IP {http.request.header.X-Forwarded-For}
                        # Jeton partage: prouve a l API que cette requete vient bien
                        # du proxy et non d un appel direct a son URL run.app, qui
                        # repond publiquement. Sans lui, n importe qui pouvait dicter
                        # X-Real-Client-IP et neutraliser toute limite par IP.
                        # Vide tant que PROXY_TOKEN n est pas defini: l API garde alors
                        # son comportement historique.
                        header_up X-Proxy-Token {$PROXY_TOKEN}
                }
        }

        handle {
                root * /srv
                @hashed path_regexp -[A-Za-z0-9_-]{8,}\.(js|css|woff2?|png|jpe?g|gif|svg|webp|avif)$
                header @hashed Cache-Control "public, max-age=31536000, immutable"
                # Le document HTML ne doit JAMAIS etre servi depuis le cache sans
                # revalidation: il porte les noms (hashes) des morceaux de code, et
                # ceux-ci disparaissent du serveur au deploiement suivant. Un
                # navigateur qui garde un vieux document demande des fichiers qui
                # n'existent plus: certains onglets s'ouvrent, les autres affichent
                # « rechargez ou reessayez ». C'est exactement le symptome remonte
                # par les utilisateurs le 2026-09-04.
                #
                # La regle existait deja — mais elle ne s'appliquait pas. `header
                # /index.html` filtre sur le chemin DEMANDE, or les navigations
                # arrivent sur `/`, `/taches`, `/appels`... et ne deviennent
                # `/index.html` qu'en interne, via `try_files`. Mesure en ligne le
                # 2026-09-04: `/` ne portait aucun Cache-Control, donc le navigateur
                # appliquait sa mise en cache heuristique.
                #
                # `no-store` n'est volontairement pas repris: il interdirait aussi le
                # cache de retour arriere du navigateur. `no-cache` dit ce qu'on veut
                # vraiment — revalider avant de reutiliser.
                @document not path_regexp -[A-Za-z0-9_-]{8,}\.(js|css|woff2?|png|jpe?g|gif|svg|webp|avif)$
                header @document Cache-Control "no-cache, must-revalidate"

                try_files {path} /index.html
                file_server
        }

        log {
                output stdout
                format console
        }
}
