# Caddyfile — Ajant Bureau (Docker Compose)
#
# DOMAIN env var controls TLS. Examples:
#   DOMAIN=:80                     → HTTP only (local dev / behind another proxy)
#   DOMAIN=app.exemple.fr          → automatic Let's Encrypt HTTPS
#
# All /api/* requests are reverse-proxied to the api container.
# Everything else is served from /srv (built React SPA) with HTML5 fallback.

{$DOMAIN:":80"} {
        encode zstd gzip

        # Applies to every response in this site block (static + proxied /api).
        # Browsers ignore Strict-Transport-Security on plain-HTTP responses, so
        # this is a safe no-op for local/dev DOMAIN=:80 setups and only takes
        # effect once DOMAIN is a real HTTPS domain.
        header {
                Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
                X-Content-Type-Options "nosniff"
                X-Frame-Options "DENY"
                Referrer-Policy "strict-origin-when-cross-origin"
                # Meme valeur que api-server (app.ts), nginx.conf et
                # Caddyfile.cloudrun. Elle doit accompagner le DOCUMENT servi
                # ici: le header pose sur les reponses JSON de /api ne gouverne
                # aucune capacite navigateur de la page.
                Permissions-Policy "accelerometer=(), autoplay=(), camera=(self), cross-origin-isolated=(), display-capture=(self), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), hid=(), identity-credentials-get=(), idle-detection=(), interest-cohort=(), keyboard-map=(), magnetometer=(), microphone=(self), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), sync-xhr=(), usb=(), xr-spatial-tracking=()"
                # Content-Security-Policy — voir deploy/csp.policy.md.
                # BLOQUANTE depuis le 2026-09-12, apres soixante jours
                # d observation en Report-Only sur la production reelle.
                #
                # Ce que ces soixante jours ont montre: ONZE violations en
                # tout. Dix venaient d un defaut a nous — une adresse
                # construite en `//api/...`, que le navigateur lisait comme
                # l hote `api` — corrige depuis. La onzieme etait une feuille
                # de style injectee par la traduction automatique du
                # navigateur, qui ne vient pas de notre page.
                #
                # Les parcours inhabituels ont ete verifies un par un plutot
                # que supposes: le paiement Stripe part par REDIRECTION
                # (window.location vers checkout.stripe.com), pas par iframe —
                # `frame-src none` ne le gene donc pas; la connexion Google est
                # une redirection, deja autorisee par `form-action`; le
                # televersement et VoiceLive restent sur la meme origine, que
                # `connect-src self` couvre, WebSocket compris.
                #
                # Ce qui est perdu, assume: la feuille de style de la
                # traduction automatique sera bloquee. C est cosmetique, sur
                # une page traduite par la machine, dans une application qui
                # embarque ses propres traductions FR/TR/EN. Ajouter un hote
                # tiers a la politique qui protege des donnees bancaires pour
                # ce seul cas serait un mauvais echange.
                #
                # `report-uri` est conserve: bloquer et continuer a apprendre
                # ne s excluent pas.
                #
                # La valeur doit rester identique a deploy/csp.policy
                # (verifie par csp-policy.test.ts).
                Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; form-action 'self' https://checkout.stripe.com https://billing.stripe.com https://accounts.google.com; base-uri 'none'; object-src 'none'; upgrade-insecure-requests; report-uri /api/csp-report"
        }

        # Forward API calls to the Node backend.
        # IMPORTANT: do NOT use handle_path here — Express mounts routes under /api
        # and expects the /api prefix to be preserved. `handle` keeps the URL intact.
        handle /api* {
                reverse_proxy api:8080
        }

        # `handle` is only mutually exclusive with OTHER handle/handle_path
        # blocks — a bare file_server/try_files at the top level still runs
        # for every request regardless of the block above, which would
        # silently serve index.html for /api/* instead of proxying it.
        # Wrapping the static site in its own `handle` makes the two routes
        # properly exclusive.
        handle {
                # Static SPA — long cache for hashed assets, no-cache for HTML
                root * /srv
                @hashed path_regexp -[A-Za-z0-9_-]{8,}\.(js|css|woff2?|png|jpe?g|gif|svg|webp|avif)$
                header @hashed Cache-Control "public, max-age=31536000, immutable"
                # Le document HTML ne doit JAMAIS etre servi depuis le cache sans
                # revalidation: il porte les noms (hashes) des morceaux de code, et
                # ceux-ci disparaissent du serveur au deploiement suivant. Un
                # navigateur qui garde un vieux document demande des fichiers qui
                # n'existent plus: certains onglets s'ouvrent, les autres affichent
                # « rechargez ou reessayez ». C'est exactement le symptome remonte
                # par les utilisateurs le 2026-09-04.
                #
                # La regle existait deja — mais elle ne s'appliquait pas. `header
                # /index.html` filtre sur le chemin DEMANDE, or les navigations
                # arrivent sur `/`, `/taches`, `/appels`... et ne deviennent
                # `/index.html` qu'en interne, via `try_files`. Mesure en ligne le
                # 2026-09-04: `/` ne portait aucun Cache-Control, donc le navigateur
                # appliquait sa mise en cache heuristique.
                #
                # `no-store` n'est volontairement pas repris: il interdirait aussi le
                # cache de retour arriere du navigateur. `no-cache` dit ce qu'on veut
                # vraiment — revalider avant de reutiliser.
                @document not path_regexp -[A-Za-z0-9_-]{8,}\.(js|css|woff2?|png|jpe?g|gif|svg|webp|avif)$
                header @document Cache-Control "no-cache, must-revalidate"

                # SPA history fallback
                try_files {path} /index.html
                file_server
        }

        log {
                output stdout
                format console
        }
}
