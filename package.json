{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "dev": "pnpm --parallel --filter @workspace/api-server --filter @workspace/buro-ajani run dev",
    "codegen": "pnpm --filter @workspace/api-spec run codegen",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:setup-test": "pnpm --filter @workspace/db run setup-test-db",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test": "pnpm -r --if-present --workspace-concurrency=1 run test",
    "test:local": "node ./scripts/run-tests-local.mjs",
    "security:audit": "pnpm audit --prod --audit-level high"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-5p2g-fcmc-qvqq"
      ]
    },
    "overrides": {
      "@babel/core": "^7.29.6",
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "body-parser": "^2.3.0",
      "brace-expansion": "5.0.9",
      "ip-address": "^10.3.1",
      "js-yaml@3": "^3.15.1",
      "js-yaml@4": "^4.3.2",
      "postcss": "^8.5.23",
      "qs": "^6.15.2",
      "shell-quote": "^1.9.0",
      "tar@7": "^7.5.19",
      "undici@6": "^6.28.0",
      "nanoid@3": "^3.3.18",
      "nanoid@5": "^5.1.16",
      "protobufjs": "^7.6.6",
      "uuid": "^11.1.1",
      "@esbuild-kit/esm-loader": "npm:tsx@^4.21.0",
      "uuid@11": "^11.1.1",
      "ws@6": "^6.2.4",
      "ws@7": "^7.5.11",
      "yaml": "^2.8.3"
    }
  }
}
