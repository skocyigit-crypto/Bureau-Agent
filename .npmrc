auto-install-peers=false
strict-peer-dependencies=false

# Un filtre qui ne correspond a aucun paquet sortait en 0, en silence:
# `pnpm --filter @workspace/nom-qui-a-derive run test` affichait
# « No projects matched the filters » et la CI restait verte — la suite
# entiere cessait de tourner sans qu'une etape soit rouge. Mesure faite ici
# en pnpm 9.15: sans ce reglage EXIT=0, avec lui EXIT=1.
# Un seul endroit couvre les ~25 appels --filter de la CI et des Dockerfiles,
# et ceux qui seront ecrits plus tard.
fail-if-no-match=true
